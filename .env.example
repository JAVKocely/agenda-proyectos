# Configuración General del Servidor
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Base de Datos
# Desarrollo local por defecto (SQLite):
DATABASE_URL=sqlite:///./agenda.db
# Producción con PostgreSQL (Docker):
# DATABASE_URL=postgresql://agenda_user:agenda_password@localhost:5432/agenda_proyectos

# Capa de Inteligencia Artificial (Llamada Directa con Structured Outputs)
# Proveedor activo: "gemini" o "groq"
AI_PROVIDER=gemini

# Google Gemini API
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API (Alternativa de ultra baja latencia)
# Obtén tu clave en: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
